GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
SECRET_KEY=replace-with-a-long-random-string
# Sent as the X-API-Key header by clients that post calls without signing in.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Sign-in links are emailed through any SMTP service (Resend, Brevo, SendGrid, Gmail app
# password, ...). Without SMTP_HOST the link is printed in the server console instead,
# which is handy in development; on Render (PRODUCTION=1) email sign-in then refuses to run.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Molers <no-reply@your-domain.example>
# Where the emailed links point. Render sets RENDER_EXTERNAL_URL itself; locally the default
# is the Vite dev server, http://localhost:5173.
APP_BASE_URL=

# Speech-to-text service used to fill the Transcript of calls with a voice message.
SPEECH_SERVER_URL=https://your-speech-server.example.com
SPEECH_SERVER_TOKEN=
SPEECH_LANGUAGE=sr-RS
