GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
SECRET_KEY=replace-with-a-long-random-string
# Sent as the X-API-Key header by clients that post calls without signing in.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"

# Speech-to-text service used to fill the Transcript of calls with a voice message.
SPEECH_SERVER_URL=https://your-speech-server.example.com
SPEECH_SERVER_TOKEN=
SPEECH_LANGUAGE=sr-RS
